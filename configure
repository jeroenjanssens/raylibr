#!/bin/sh

UNAME=$(uname)
case "$UNAME" in
  Linux)
    SYS_LIBS="-lGL -lm -lpthread -ldl -lrt -lX11"
    ;;
  Darwin)
    SYS_LIBS="-framework OpenGL -framework Cocoa -framework IOKit -framework CoreFoundation -framework CoreGraphics"
    ;;
  *)
    SYS_LIBS=""
    ;;
esac

# Detect clang and suppress warnings from R's own headers
CXX=$("${R_HOME}/bin/R" CMD config CXX 2>/dev/null)
EXTRA_CXXFLAGS=""
if $CXX --version 2>&1 | grep -qi clang; then
  EXTRA_CXXFLAGS="-Wno-unknown-warning-option"
fi

sed -e "s|@SYS_LIBS@|$SYS_LIBS|" \
    -e "s|@EXTRA_CXXFLAGS@|$EXTRA_CXXFLAGS|" \
    src/Makevars.in > src/Makevars
