#!/bin/sh

# Headers the bundled Raylib (GLFW's X11 backend) needs on Linux, with the
# Debian/Ubuntu and Fedora packages that provide them
check_linux_headers() {
  CC=$("${R_HOME}/bin/R" CMD config CC)
  CPPFLAGS=$("${R_HOME}/bin/R" CMD config CPPFLAGS)
  MISSING=""
  for header in X11/Xlib.h X11/extensions/Xrandr.h X11/extensions/Xinerama.h \
                X11/Xcursor/Xcursor.h X11/extensions/XInput2.h X11/extensions/shape.h \
                GL/gl.h GL/glx.h; do
    if ! printf '#include <%s>\n' "$header" | $CC $CPPFLAGS -E -x c - > /dev/null 2>&1; then
      MISSING="$MISSING $header"
    fi
  done
  if [ -n "$MISSING" ]; then
    echo "------------------------------------------------------------------------"
    echo "raylibr needs X11 and OpenGL development headers, but these are missing:"
    echo " $MISSING"
    echo ""
    echo "Install them with, for example:"
    echo "  Debian/Ubuntu: sudo apt-get install libx11-dev libxrandr-dev libxinerama-dev"
    echo "                   libxcursor-dev libxi-dev libxext-dev libgl-dev"
    echo "  Fedora/RHEL:   sudo dnf install libX11-devel libXrandr-devel libXinerama-devel"
    echo "                   libXcursor-devel libXi-devel libXext-devel mesa-libGL-devel"
    echo "------------------------------------------------------------------------"
    exit 1
  fi
}

UNAME=$(uname)
case "$UNAME" in
  Linux)
    check_linux_headers
    SYS_LIBS="-lGL -lm -lpthread -ldl -lrt -lX11"
    ;;
  Darwin)
    SYS_LIBS="-framework OpenGL -framework Cocoa -framework IOKit -framework CoreFoundation -framework CoreGraphics"
    ;;
  *)
    SYS_LIBS=""
    ;;
esac

sed "s|@SYS_LIBS@|$SYS_LIBS|" src/Makevars.in > src/Makevars
